# Template delle variabili d'ambiente.
#
# Questo file È committato su git e deve contenere SOLO valori vuoti o finti:
# serve a documentare quali variabili esistono.
#
# Uso:
#   cp .env.example .env
# e poi riempi .env con i valori veri. Il file .env è in .gitignore
# e non deve MAI finire in un commit.

# --- Credenziali Fisconline / Entratel ---------------------------------------

# Nome utente rilasciato dall'Agenzia delle Entrate.
ADE_USERNAME=

# Password di accesso.
ADE_PASSWORD=

# PIN personale.
ADE_PIN=

# Codice fiscale del soggetto di cui si leggono le fatture.
# Se accedi per conto tuo coincide con il tuo CF; se operi come delegato o
# intermediario è il CF/P.IVA del soggetto delegante.
ADE_CODICE_FISCALE=

# --- Comportamento dello script ----------------------------------------------

# Dove salvare gli XML delle fatture. Se la lasci vuota si usa `fatture/` nella
# radice del progetto, divisa in `fatture/emesse` e `fatture/ricevute`.
# Serve valorizzarla solo per archiviare altrove (per esempio su un altro disco
# quando lo script gira via cron). La cartella è in .gitignore.
EXTR_ADE_INVOICES_DIR=

# Cartella per i file di diagnostica (HTML salvati durante le ispezioni).
EXTR_ADE_DATA_DIR=data

# Livello di log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
